{
  "name": "@oscar-robin/pi-overview",
  "version": "0.5.0",
  "description": "A native macOS menu bar overview and manager for Pi instances.",
  "type": "module",
  "license": "MIT",
  "author": "Oscar Cooke-Abbott",
  "repository": { "type": "git", "url": "git+https://github.com/OscarCookeAbbott/pi-overview.git" },
  "homepage": "https://github.com/OscarCookeAbbott/pi-overview#readme",
  "bugs": { "url": "https://github.com/OscarCookeAbbott/pi-overview/issues" },
  "keywords": ["pi-package", "pi-extension", "macos", "menubar", "overview"],
